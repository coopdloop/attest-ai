# =============================================================================
# attest-ai environment variables
# Copy to .env and fill in values before running docker compose.
# =============================================================================

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=attest_ai
POSTGRES_USER=attest
POSTGRES_PASSWORD=changeme

# Shared DSN used by all services
DATABASE_URL=postgres://attest:changeme@postgres:5432/attest_ai

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ROOT_USER=attest
MINIO_ROOT_PASSWORD=changeme123
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=attest-ai-traces
OBJECT_STORE_ACCESS_KEY=attest
OBJECT_STORE_SECRET_KEY=changeme123

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── signing_service ───────────────────────────────────────────────────────────
SIGNING_SERVICE_URL=signing_service:8083   # gRPC, no http:// prefix
KEY_STORE_BACKEND=local                    # "local" | "vault"
LOCAL_KEY_PATH=/keys                       # mounted volume path
# VAULT_ADDR=https://vault:8200
# VAULT_TOKEN=

# ── auth_service ──────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/keys/jwt_private.pem # RSA-2048 PEM, mounted into container
SINGLE_USER_MODE=true                      # set false for org/SSO mode
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/attestai
# SAML_METADATA_URL=

# ── agent_orchestrator ────────────────────────────────────────────────────────
ATTESTATION_SERVICE_URL=http://attestation_service:8082
CONTEXT_LIBRARY_URL=http://context_library:8001
LITELLM_CONFIG_PATH=/config/litellm.yaml
MCP_SERVER_REGISTRY_PATH=/config/mcp_servers.yaml
OLLAMA_BASE_URL=http://host.docker.internal:11434   # local Ollama (dev only)

# Model provider API keys
# OpenRouter gives access to all models through a single key (recommended)
OPENROUTER_API_KEY=

# Direct provider keys (only needed if bypassing OpenRouter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Threat Intel tool API keys (all optional) ─────────────────────────────────
VT_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=

# ── Recon tool ────────────────────────────────────────────────────────────────
SCOPE_CONFIG_PATH=/config/scope.yaml

# ── Red-team tool ─────────────────────────────────────────────────────────────
PAYLOAD_LIBRARY_PATH=/config/payloads
DEFAULT_TARGET_TIMEOUT_MS=15000

# ── api_gateway ───────────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth_service:8081
ORCHESTRATOR_URL=http://agent_orchestrator:8000

# ── attestation_service ───────────────────────────────────────────────────────
REKOR_ENABLED=false
# REKOR_SERVER_URL=https://rekor.sigstore.dev

# ── frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:8081
NEXT_PUBLIC_TRACE_QUERY_URL=http://localhost:8084

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
